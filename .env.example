# Postgres from docker-compose.yml (`docker compose up -d db`).
DATABASE_URL="postgresql://opencanva:opencanva@localhost:5432/opencanva"

# Directory for uploaded files. In Docker this is a mounted volume.
DATA_DIR="./data"

# Stock photos (Photos tab): a free key from https://www.pexels.com/api/. Without it the tab explains what to set.
PEXELS_API_KEY=""

# AI tools (AI tab). Text: an Anthropic API key (ANTHROPIC_MODEL overrides the model, default claude-opus-5-5).
# Images: an OpenAI-compatible image API (OPENAI_BASE_URL and OPENAI_IMAGE_MODEL override, default gpt-image-1).
# Without a key the tab explains what to set; prompts and edited pictures are sent to these providers.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Docker Compose only (docker compose up -d --build); see README.md.
# Where the app is published. Keep it local unless a VPN or authenticating proxy is in front.
# APP_BIND="127.0.0.1:3000"
# Database password; set it before the first start (and use it in DATABASE_URL above for development).
# POSTGRES_PASSWORD="opencanva"
# DB_BIND="127.0.0.1:5432"
